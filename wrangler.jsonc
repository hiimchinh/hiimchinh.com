/**
 * Static site on Cloudflare Workers (assets only, no Worker code).
 * `pnpm build` writes ./dist; CI runs `wrangler deploy` on every push to main.
 * public/_redirects carries the old Hugo URLs.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiimchinh-com",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
