---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

import { toLocale } from "@/utils/getLocalizedPosts";

const locale = toLocale(Astro.currentLocale);
const translation = await getEntry("pages", `${locale}/about`);
const about = translation ?? (await getEntry("pages", "en/about"));
// Without its own translation the page is a copy of the English one.
const englishURL = new URL("/about/", Astro.site).href;
const hasBothLanguages = Boolean(
  (await getEntry("pages", "en/about")) && (await getEntry("pages", "vi/about"))
);

if (!about) {
  throw new Error(
    "Missing content entry: `en/about.md` in `src/content/pages/`"
  );
}

const { Content } = await render(about);
---

<Layout
  title={`${about.data.title} | ${config.site.title}`}
  description={about.data.description}
  ogImage={about.data.ogImage}
  canonicalURL={about.data.canonicalURL ??
    (translation ? undefined : englishURL)}
  translated={hasBothLanguages}
>
  <Header />

  <Breadcrumb />

  <Main pageTitle={about.data.title} class="app-prose">
    <Content />
  </Main>

  <Footer />
</Layout>
