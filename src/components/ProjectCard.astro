---
import type { CollectionEntry } from "astro:content";
import { useTranslations } from "@/i18n";
import config from "@/config";

type Props = { project: CollectionEntry<"projects"> };

const { project } = Astro.props;
const { title, summary, role, period, status, url, repo, stack } = project.data;
const t = useTranslations(Astro.currentLocale ?? config.site.lang);
const href = url ?? repo;
---

<li class="border-border my-6 border-b pb-6 last:border-b-0">
  <div
    class="flex flex-col gap-y-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-x-4"
  >
    <h3 class="text-lg font-semibold">
      {
        href ? (
          <a
            href={href}
            class="text-accent decoration-dashed underline-offset-4 hover:underline"
          >
            {title}
          </a>
        ) : (
          title
        )
      }
    </h3>
    <span class="text-muted-foreground text-sm">
      {role} · {period} · {t.projectStatus[status]}
    </span>
  </div>
  <p class="mt-2">{summary}</p>
  {
    stack.length > 0 && (
      <p class="text-muted-foreground mt-2 font-mono text-sm">
        {stack.join(" · ")}
      </p>
    )
  }
</li>
